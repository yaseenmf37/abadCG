# Set a strong private password before starting the order manager.
ADMIN_PASSWORD=1235
# Generate a random secret, for example with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret
API_PORT=3001
SUPABASE_URL=
# Keep the service role key server-side only. Never prefix it with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=abad-media
